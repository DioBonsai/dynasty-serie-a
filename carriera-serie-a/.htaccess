# Il server non mandava alcun header di cache per index.html (solo Last-Modified), quindi i
# browser potevano continuare a servire una copia vecchia della pagina anche dopo un deploy,
# ignorando i "?v=N" su styles.css/sim.js/ui.js perché quei nomi stavano dentro un HTML
# stantio. Qui forziamo il browser a rivalidare SEMPRE l'HTML (una richiesta in più, quasi
# gratis) mentre CSS/JS, che cambiano nome ad ogni release grazie al "?v=N", possono restare
# in cache a lungo senza problemi.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
