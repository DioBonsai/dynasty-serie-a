# Il server non mandava alcun header di cache per index.html (solo Last-Modified), quindi i
# browser potevano continuare a servire una copia vecchia della pagina anche dopo un deploy,
# ignorando i "?v=N" su styles.css/sim.js/ui.js perché quei nomi stavano dentro un HTML
# stantio. Qui forziamo il browser a rivalidare SEMPRE l'HTML (una richiesta in più, quasi
# gratis) mentre CSS/JS, che cambiano nome ad ogni release grazie al "?v=N", possono restare
# in cache a lungo senza problemi.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <!-- sw.js e manifest.json restano SEMPRE no-cache anche se sono .js/.json: sw.js in
       particolare deve poter essere ricontrollato dal browser ad ogni deploy (un service
       worker aggiornato ma servito con cache lunga può restare "vecchio" per un anno),
       quindi questa regola più specifica deve stare DOPO quella generale su *.js per
       sovrascriverla (Apache applica l'ultimo <FilesMatch> che corrisponde). -->
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
